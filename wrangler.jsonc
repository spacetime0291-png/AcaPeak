{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acapeak",
  "compatibility_date": "2024-11-01",
  "main": "src/worker.ts",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": false
  }
}
