{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UTBKTacticalPlaybookMaterial",
  "description": "JSON schema for exam-pattern and question-driven UTBK learning materials",
  "type": "object",
  "required": ["metadata", "content", "worked_examples"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "subtest",
        "chapter_num",
        "chapter_title",
        "subchapter_num",
        "subchapter_title",
        "title",
        "required_question_variations",
        "requires_svg",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier, e.g. pu-1.1, pk-3.1"
        },
        "subtest": {
          "type": "string",
          "enum": ["PU", "PPU", "PBM", "PK", "LBI", "LBE", "PM"]
        },
        "chapter_num": {
          "type": "integer",
          "minimum": 1
        },
        "chapter_title": {
          "type": "string"
        },
        "subchapter_num": {
          "type": "string"
        },
        "subchapter_title": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "required_question_variations": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "requires_svg": {
          "type": "boolean"
        },
        "updated_at": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "content": {
      "type": "object",
      "required": [
        "exam_blueprint_markdown",
        "visualizations_svg",
        "distractor_traps"
      ],
      "properties": {
        "tactical_overview": {
          "type": "string"
        },
        "exam_blueprint_markdown": {
          "type": "string",
          "description": "Tactical table mapping UTBK question patterns to testing points and quick 30s execution algorithms"
        },
        "visualizations_svg": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "caption", "svg_code"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "caption": { "type": "string" },
              "svg_code": { "type": "string" }
            }
          }
        },
        "distractor_traps": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Pola jebakan opsi pengecoh khas UTBK di topik ini"
        },
        "quick_execution_algorithm": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "worked_examples": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "example_id",
          "variation_name",
          "difficulty",
          "question_type",
          "question_markdown",
          "options",
          "correct_answer",
          "conceptual_solution_markdown",
          "quick_trick_markdown",
          "why_others_are_wrong_markdown"
        ],
        "properties": {
          "example_id": { "type": "string" },
          "variation_name": {
            "type": "string",
            "description": "Label variasi soal, misal 'Variasi 1: Menentukan Pernyataan yang Memperlemah Hipotesis'"
          },
          "difficulty": {
            "type": "string",
            "enum": ["easy", "medium", "hard"]
          },
          "question_type": {
            "type": "string"
          },
          "context_markdown": {
            "type": ["string", "null"]
          },
          "svg_illustration": {
            "type": ["object", "null"],
            "properties": {
              "id": { "type": "string" },
              "svg_code": { "type": "string" }
            },
            "required": ["id", "svg_code"]
          },
          "question_markdown": { "type": "string" },
          "statements": {
            "type": ["array", "null"],
            "items": { "type": "string" }
          },
          "complex_table": {
            "type": ["object", "null"]
          },
          "options": {
            "type": "array",
            "minItems": 4,
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": ["key", "text_markdown"],
              "properties": {
                "key": {
                  "type": "string"
                },
                "text_markdown": { "type": "string" }
              }
            }
          },
          "correct_answer": {
            "type": "string"
          },
          "conceptual_solution_markdown": { "type": "string" },
          "quick_trick_markdown": { "type": "string" },
          "why_others_are_wrong_markdown": {
            "type": "string",
            "description": "Bedah opsi salah A, B, C, D, E dan jebakan apa yang dipakai"
          }
        }
      }
    }
  }
}
