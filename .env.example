# Base public canonical URL (override during production build for custom domain)
SITE_URL=https://skolace.my.id

# Optional cookie-free Cloudflare Web Analytics token
VITE_CF_BEACON_TOKEN=

# Google AdSense Publisher ID (e.g. ca-pub-XXXXXXXXXXXXXXXX)
VITE_ADSENSE_CLIENT_ID=

# Set to "true" only after AdSense approval to render <AdSlot /> containers
VITE_ADSENSE_SLOTS_ENABLED=false

# Optional JSON POST endpoint for the /contact feedback/errata form
VITE_CONTACT_FORM_ENDPOINT=
